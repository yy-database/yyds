{
    "private": true,
    "type": "module",
    "scripts": {
        "check": "cargo check --workspace",
        "fmt": "node scripts/format.mjs",
        "fmt:check": "node scripts/format.mjs --check",
        "test": "cargo test --release --workspace",
        "build:napi": "node scripts/build-napi.mjs",
        "build:wasm": "node scripts/build-wasm.mjs",
        "typecheck": "pnpm -r --filter @yyds/yyds --filter @yyds/yyds-unknown-wasm32 --filter @yyds/redis --filter @yyds/mysql --filter @yyds/postgresql --filter @yyds/sqlite run typecheck",
        "test:ts": "pnpm -r --filter @yyds/yyds --filter @yyds/redis --filter @yyds/mysql --filter @yyds/postgresql --filter @yyds/sqlite run test",
        "p": "git push && git push --tags --prune",
        "u": "cargo upgrade --pinned",
        "placeholder": "nifty publish --placeholder --dry-run",
        "placeholder:publish": "nifty publish --placeholder",
        "placeholder:publish:skills": "nifty publish --placeholder --package @yyds/yyds-skills",
        "placeholder:trust": "nifty trust",
        "placeholder:trust:skills": "nifty trust --only @yyds/yyds-skills"
    },
    "packageManager": "pnpm@10.18.3",
    "devDependencies": {
        "@biomejs/biome": "^2.4.8",
        "@doki-land/nifty": "^0.0.12",
        "@napi-rs/cli": "^2.18.4"
    }
}
