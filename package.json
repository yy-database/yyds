{
    "private": true,
    "type": "module",
    "scripts": {
        "check": "cargo check --manifest-path projects/yyds.rs/Cargo.toml --workspace",
        "fmt": "node scripts/format.mjs",
        "fmt:check": "node scripts/format.mjs --check",
        "test": "cargo test --manifest-path projects/yyds.rs/Cargo.toml --release --workspace",
        "build:napi": "node scripts/build-napi.mjs",
        "build:ts": "pnpm -r --filter @yydb/yyds run build",
        "build:webui": "pnpm --filter @yydb/yyds run build:webui",
        "gate:install:ts": "node scripts/gate-install-ts.mjs",
        "typecheck": "pnpm -r --filter @yydb/yyds --filter @yydb/yyds-node-harness run typecheck",
        "test:ts": "pnpm -r --filter @yydb/yyds run test",
        "gate:test-count:py": "node scripts/assert-test-count.mjs redis-py mongo-py",
        "test:py": "python -m unittest discover -s projects/yyds.py/packages/yyds/tests",
        "test:sql-smoke": "node projects/yyds.ts/packages/yyds-harness/run.mjs",
        "check:py": "cargo check --manifest-path projects/yyds.rs/Cargo.toml -p yyds-pyo3",
        "p": "git push && git push --tags --prune",
        "u": "cargo upgrade --pinned",
        "placeholder": "nifty publish --placeholder --dry-run",
        "placeholder:publish": "nifty publish --placeholder",
        "placeholder:publish:skills": "nifty publish --placeholder --package @yydb/yyds-skills",
        "placeholder:trust": "nifty trust",
        "placeholder:trust:skills": "nifty trust --only @yydb/yyds-skills"
    },
    "packageManager": "pnpm@10.18.3",
    "devDependencies": {
        "@doki-land/nifty": "^0.1.9",
        "@napi-rs/cli": "^2.18.4"
    }
}
