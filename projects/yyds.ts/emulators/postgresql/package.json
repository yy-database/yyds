{
    "name": "@yydb/postgresql",
    "version": "0.1.2",
    "description": "Pretend you installed PostgreSQL. YYDS scripting runtime underneath.",
    "license": "MPL-2.0",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./node": {
            "types": "./dist/node.d.ts",
            "import": "./dist/node.js",
            "default": "./dist/node.js"
        }
    },
    "bin": {
        "psql": "bin/psql.mjs",
        "postgres": "bin/postgres.mjs"
    },
    "files": [
        "bin",
        "dist",
        "readme.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "node --experimental-strip-types --test \"./tests/**/*.test.ts\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yy-database/yyds.git",
        "directory": "projects/yyds.ts/emulators/postgresql"
    },
    "homepage": "https://github.com/yy-database/yyds/tree/dev/projects/yyds.ts/emulators/postgresql#readme",
    "bugs": {
        "url": "https://github.com/yy-database/yyds/issues"
    },
    "keywords": [
        "yyds",
        "postgresql",
        "postgres",
        "disguise"
    ],
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@yydb/yyds": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "@types/pg": "^8.18.0",
        "@yydb/yyds-node-harness": "workspace:*",
        "pg": "^8.23.1",
        "typescript": "^5.9.2"
    },
    "engines": {
        "node": ">=18"
    }
}
