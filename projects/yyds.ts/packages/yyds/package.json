{
    "name": "@yydb/yyds",
    "version": "0.1.1",
    "description": "Node.js facade, CLI, and native bindings for local YYDS nodes.",
    "license": "MPL-2.0",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/node/index.d.ts",
            "node": "./dist/node/index.js",
            "default": "./dist/node/unsupported.js"
        },
        "./node": {
            "types": "./dist/node/index.d.ts",
            "node": "./dist/node/index.js",
            "default": "./dist/node/unsupported.js"
        },
        "./node/cluster": {
            "types": "./dist/node/cluster.d.ts",
            "node": "./dist/node/cluster.js",
            "default": "./dist/node/unsupported.js"
        },
        "./node/runtime": {
            "types": "./dist/node/runtime.d.ts",
            "node": "./dist/node/runtime.js",
            "default": "./dist/node/unsupported.js"
        }
    },
    "bin": {
        "yyds": "bin/yyds.mjs"
    },
    "files": [
        "bin",
        "dist",
        "webui",
        "readme.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "build:webui": "node scripts/bundle-webui.mjs",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "node --experimental-strip-types --test \"./tests/**/*.test.ts\" \"./src/node/**/*.test.ts\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yy-database/yyds.git",
        "directory": "projects/yyds.ts/packages/yyds"
    },
    "homepage": "https://github.com/yy-database/yyds/tree/dev/projects/yyds.ts/packages/yyds#readme",
    "bugs": {
        "url": "https://github.com/yy-database/yyds/issues"
    },
    "keywords": [
        "yyds",
        "scripting",
        "typescript",
        "napi"
    ],
    "publishConfig": {
        "access": "public"
    },
    "optionalDependencies": {
        "@yydb/yyds-win32-x64": "workspace:*",
        "@yydb/yyds-linux-x64": "workspace:*",
        "@yydb/yyds-darwin-x64": "workspace:*",
        "@yydb/yyds-darwin-arm64": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "@yydb/yyds-webui": "workspace:*",
        "typescript": "^5.9.2"
    },
    "engines": {
        "node": ">=18"
    }
}
