  homeFeatureScalarTitle: 'Exact scalars',
  homeFeatureScalarBody: 'date, time, timestamp and decimal use structured encodings and never degrade to strings or lossy floats.',
  homeFeatureHostTitle: 'Consistent across hosts',
  homeFeatureHostBody: 'Rust embedding, CLI, Node.js, browser and WebUI share one file model and one VOS contract.',
  homeFeatureWireTitle: 'Optional local wire',
  homeFeatureWireBody: 'yyds start exposes TCP and WebSocket /wire carrying YY binary frames, not JSON REST.',

