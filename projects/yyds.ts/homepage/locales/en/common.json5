  installCliWebui: 'Start the local WebUI and open a browser. --no-open disables opening',
  installCliNote: '--redis-port defaults to 6379. --pgsql-port, --mysql-port, --mongo-port and --wire-port must be passed explicitly.',

  installGwTitle: 'Protocol gateways',
  installGwBody: 'The node listens on each protocol whose port flag was passed to start. Connect with standard clients.',
  installGwColProtocol: 'Protocol',
  installGwColConnect: 'Connect',
  installGwRedis: 'redis-cli -p 6379',
  installGwPgsql: 'psql -h 127.0.0.1 -p PORT (value passed to --pgsql-port)',
  installGwMysql: 'mysql -h 127.0.0.1 -P PORT (value passed to --mysql-port)',
  installGwMongo: 'mongosh --port PORT (value passed to --mongo-port)',
  installGwNote: 'The SQL gateway requires --catalog-path with a published schema. Execution is currently single-node single-shard, and the MongoDB gateway is still a handshake probe.',

