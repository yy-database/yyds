  homeFeatureTitle: 'Capabilities',
  homeFeatureLede: 'The following reflects the current release. Roadmap items are marked separately in the matrix.',
  homeFeatureSchemaTitle: 'Structured schema',
  homeFeatureSchemaBody: 'A versioned VOS document lives inside the same .yydb file as the data, with explicit field types and primary keys.',
  homeFeatureDurabilityTitle: 'Durable records and WAL',
  homeFeatureDurabilityBody: 'Pages, WAL and checkpointing are built in, so a file reopens cleanly after an interrupted write.',
  homeFeatureObjectTitle: 'Content-addressed objects',
