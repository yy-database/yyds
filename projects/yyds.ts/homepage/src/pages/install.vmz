                <table class="rule-table">
                    <thead>
                        <tr>
                            <th scope="col">{{ installGwColProtocolLabel }}</th>
                            <th scope="col">{{ installGwColConnectLabel }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th scope="row"><code>Redis</code></th>
                            <td><code>{{ installGwRedisLabel }}</code></td>
                        </tr>
                        <tr>
                            <th scope="row"><code>PostgreSQL</code></th>
                            <td><code>{{ installGwPgsqlLabel }}</code></td>
                        </tr>
                        <tr>
                            <th scope="row"><code>MySQL</code></th>
                            <td><code>{{ installGwMysqlLabel }}</code></td>
                        </tr>
                        <tr>
                            <th scope="row"><code>MongoDB</code></th>
                            <td><code>{{ installGwMongoLabel }}</code></td>
                        </tr>
                    </tbody>
                </table>
                <p class="note">{{ installGwNoteLabel }}</p>
            </section>

            <section class="section" id="webui">
                <div class="install-step">
                    <div class="install-step__label">02 · webui</div>
                    <div>
                        <h2>{{ installWebuiTitleLabel }}</h2>
                        <p>{{ installWebuiBodyLabel }}</p>
                        <div class="code-block">
                            <div class="code-block__bar">shell</div>
                            <pre>npx @yydb/yyds webui --data-dir ./node --port 8700</pre>
                        </div>
                        <p style="margin-top:0.75rem">{{ installWebuiNoteLabel }}</p>
                    </div>
                </div>
            </section>

            <section class="section" id="verify">
                <div class="install-step">
                    <div class="install-step__label">03 · verify</div>
                    <div>
                        <h2>{{ installVerifyTitleLabel }}</h2>
                        <p>{{ installVerifyBodyLabel }}</p>
                        <div class="code-block">
                            <div class="code-block__bar">shell</div>
                            <pre>npx @yydb/yyds init --data-dir ./node --cluster-id c1 --node-id n1
npx @yydb/yyds start --data-dir ./node --cluster-id c1 --node-id n1 --redis-port 6379
npx @yydb/yyds status --data-dir ./node
npx @yydb/yyds stop --data-dir ./node</pre>
                        </div>
                    </div>
                </div>
            </section>

            <section class="section" id="errors">
                <div class="section__head">
                    <div>
                        <h2 class="section__title">{{ installErrorsTitleLabel }}</h2>
                        <p class="section__lede">{{ installErrorsLedeLabel }}</p>
                    </div>
                </div>
                <table class="rule-table">
                    <thead>
                        <tr>
                            <th scope="col">{{ installErrColSymptomLabel }}</th>
                            <th scope="col">{{ installErrColCauseLabel }}</th>
                            <th scope="col">{{ installErrColActionLabel }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th scope="row">{{ installErrBindingTitleLabel }}</th>
                            <td>{{ installErrBindingCauseLabel }}</td>
                            <td>{{ installErrBindingActionLabel }}</td>
                        </tr>
                        <tr>
                            <th scope="row">{{ installErrUsageTitleLabel }}</th>
                            <td>{{ installErrUsageCauseLabel }}</td>
                            <td>{{ installErrUsageActionLabel }}</td>
                        </tr>
                        <tr>
