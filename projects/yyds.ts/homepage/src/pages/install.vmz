                <a href="#errors">{{ installTocErrorsLabel }}</a>
                <a href="#remove">{{ installTocRemoveLabel }}</a>
            </nav>

            <section class="section" id="requirements" style="border-top:0;margin-top:1.5rem">
                <div class="section__head">
                    <div>
                        <h2 class="section__title">{{ installReqTitleLabel }}</h2>
                        <p class="section__lede">{{ installReqBodyLabel }}</p>
                    </div>
                </div>
                <table class="rule-table">
                    <thead>
                        <tr>
                            <th scope="col">{{ installReqColRequirementLabel }}</th>
                            <th scope="col">{{ installReqColValueLabel }}</th>
                            <th scope="col">{{ installReqColNoteLabel }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th scope="row">{{ installReqRowNodeLabel }}</th>
                            <td><code>18+</code></td>
                            <td>{{ installReqRowNodeNoteLabel }}</td>
                        </tr>
                        <tr>
                            <th scope="row">{{ installReqRowNpmLabel }}</th>
                            <td><code>npm / pnpm / yarn</code></td>
                            <td>{{ installReqRowNpmNoteLabel }}</td>
                        </tr>
                        <tr>
                            <th scope="row">{{ installReqRowOsLabel }}</th>
                            <td><code>win32-x64 · linux-x64 · darwin-x64 · darwin-arm64</code></td>
                            <td>{{ installReqRowOsNoteLabel }}</td>
                        </tr>
                        <tr>
                            <th scope="row">{{ installReqRowClientLabel }}</th>
                            <td><code>redis-cli · psql · mysql · mongosh</code></td>
                            <td>{{ installReqRowClientNoteLabel }}</td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <section class="section" id="node">
                <div class="install-step">
                    <div class="install-step__label">01 · npm</div>
                    <div>
                        <h2>{{ installNodeTitleLabel }}</h2>
                        <p>{{ installNodeBodyLabel }}</p>
                        <div class="code-block">
                            <div class="code-block__bar">shell</div>
                            <pre>npm install @yydb/yyds</pre>
                        </div>
                        <div class="code-block">
                            <div class="code-block__bar">app.ts</div>
                            <pre>import { runNodeStart } from "@yydb/yyds/node";

await runNodeStart({
    dataDir: "./node",
    clusterId: "c1",
    nodeId: "n1",
    redisPort: 6379,
});</pre>
                        </div>
                        <p style="margin-top:0.75rem">{{ installNodeNoteLabel }}</p>
                    </div>
                </div>
            </section>

            <section class="section" id="platform">
                <div class="section__head">
                    <div>
                        <h2 class="section__title">{{ installPlatformTitleLabel }}</h2>
                        <p class="section__lede">{{ installPlatformBodyLabel }}</p>
                    </div>
                </div>
                <table class="rule-table">
                    <thead>
                        <tr>
                            <th scope="col">{{ installPlatformColPackageLabel }}</th>
                            <th scope="col">{{ installPlatformColTargetLabel }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>@yydb/yyds-win32-x64</code></td>
                            <td>{{ installPlatformWinLabel }}</td>
                        </tr>
                        <tr>
                            <td><code>@yydb/yyds-linux-x64</code></td>
                            <td>{{ installPlatformLinuxLabel }}</td>
                        </tr>
                        <tr>
                            <td><code>@yydb/yyds-darwin-x64</code></td>
                            <td>{{ installPlatformDarwinX64Label }}</td>
                        </tr>
                        <tr>
                            <td><code>@yydb/yyds-darwin-arm64</code></td>
                            <td>{{ installPlatformDarwinArmLabel }}</td>
                        </tr>
                    </tbody>
                </table>
                <p class="note">{{ installPlatformNoteLabel }}</p>
            </section>

            <section class="section" id="cli">
                <div class="section__head">
                    <div>
                        <h2 class="section__title">{{ installCliTitleLabel }}</h2>
                        <p class="section__lede">{{ installCliBodyLabel }}</p>
                    </div>
                </div>
                <table class="rule-table">
                    <thead>
                        <tr>
                            <th scope="col">{{ installCliColCommandLabel }}</th>
                            <th scope="col">{{ installCliColUseLabel }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>yyds init</code></td>
                            <td>{{ installCliInitLabel }}</td>
                        </tr>
                        <tr>
                            <td><code>yyds start</code></td>
                            <td>{{ installCliStartLabel }}</td>
                        </tr>
                        <tr>
                            <td><code>yyds status</code></td>
                            <td>{{ installCliStatusLabel }}</td>
                        </tr>
                        <tr>
                            <td><code>yyds stop</code></td>
                            <td>{{ installCliStopLabel }}</td>
                        </tr>
                        <tr>
                            <td><code>yyds catalog</code></td>
                            <td>{{ installCliCatalogLabel }}</td>
                        </tr>
                        <tr>
                            <td><code>yyds webui</code></td>
                            <td>{{ installCliWebuiLabel }}</td>
                        </tr>
                    </tbody>
                </table>
                <p class="note">{{ installCliNoteLabel }}</p>
                <div class="code-block" style="margin-top:1rem">
                    <div class="code-block__bar">shell</div>
                    <pre>npx @yydb/yyds catalog --catalog-path ./node/catalog.yyds --schema-file schema.vos</pre>
                </div>
            </section>

            <section class="section" id="gateway">
                <div class="section__head">
                    <div>
                        <h2 class="section__title">{{ installGwTitleLabel }}</h2>
                        <p class="section__lede">{{ installGwBodyLabel }}</p>
