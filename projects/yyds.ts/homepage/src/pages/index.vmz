<path class="at-link" d="M200 168H212"/>
<path class="at-link" d="M100 204V232"/>
<g><rect class="at-hollow" x="0" y="232" width="360" height="72"/>
<text class="at-node-plain" x="16" y="260">Gateway · declared ports</text>
<text class="at-sub" x="16" y="282">TCP + WS · five protocols</text></g>
<path class="at-link" d="M180 304V336"/>
<text class="at-meta" x="0" y="352">Clients</text>
<g><text class="at-client" x="26" y="380">psql</text><text class="at-sub" x="360" y="380" text-anchor="end">PostgreSQL · 5432</text><path class="at-link" d="M0 375H14"/></g>
<g><text class="at-client" x="26" y="420">mysql</text><text class="at-sub" x="360" y="420" text-anchor="end">MySQL · 3306</text><path class="at-link" d="M0 415H14"/></g>
<g><text class="at-client" x="26" y="460">redis-cli</text><text class="at-sub" x="360" y="460" text-anchor="end">Redis · 6379</text><path class="at-link" d="M0 455H14"/></g>
<g><text class="at-client" x="26" y="500">mongosh</text><text class="at-sub" x="360" y="500" text-anchor="end">MongoDB · probe</text><path class="at-link" d="M0 495H14"/></g>
<g><text class="at-client" x="26" y="540">@yydb/yydb-client</text><text class="at-sub" x="360" y="540" text-anchor="end">YY wire · TCP + WS</text><path class="at-link" d="M0 535H14"/></g>
</svg>
                    <figcaption><span>{{ homeTopologyCaptionLabel }}</span><span class="mesh-legend"><span><i class="lg-live"></i>Solid · executing</span><span><i class="lg-hollow"></i>Hollow · declared</span><span><i class="lg-road"></i>Dashed · roadmap</span><span aria-hidden="true">Figure 01</span></span></figcaption>
                </figure>
            </div>
            <div class="landing-wrap hero-baseline">
                <div><button class="install-chip" type="button" @click='(() => copyInstall())' :aria-label="installChipAria"><span class="install-glyph" aria-hidden="true">⌘</span><span class="install-chip__text">{{ installChipText }}</span></button><span class="install-description">{{ homeInstallHintLabel }}</span></div>
                <span class="edition-label">{{ homeEditionLabel }}</span>
            </div>
        </section>
        <section class="principles landing-wrap" aria-label="Product principles">
            <div data-reveal="true"><span class="principle-index">01</span><h2>{{ homePrinciple1TitleLabel }}</h2><p>{{ homePrinciple1BodyLabel }}</p></div>
            <div data-reveal="true"><span class="principle-index">02</span><h2>{{ homePrinciple2TitleLabel }}</h2><p>{{ homePrinciple2BodyLabel }}</p></div>
            <div data-reveal="true"><span class="principle-index">03</span><h2>{{ homePrinciple3TitleLabel }}</h2><p>{{ homePrinciple3BodyLabel }}</p></div>
        </section>
        <section class="route-section">
            <div class="landing-wrap route-section__head">
                <div class="route-section__copy">
                    <p class="overline">01 — Route table</p>
                    <h2>{{ homeArchitectureTitleLabel }}</h2>
                    <p class="section-description">{{ homeArchitectureBodyLabel }}</p>
                    <a class="inline-link" href="/wire">{{ homeArchitectureLinkLabel }}<span aria-hidden="true">→</span></a>
                </div>
            </div>
            <div class="landing-wrap" data-reveal="true">
                <table class="route-table">
                    <thead><tr><th scope="col">Protocol</th><th scope="col">Client</th><th scope="col">Declare</th><th scope="col">Status</th></tr></thead>
                    <tbody>
                        <tr><td>PostgreSQL wire</td><td data-label="Client">psql</td><td data-label="Declare">--pgsql-port</td><td data-label="Status"><span class="status-text"><span class="live-dot"></span>Live</span></td></tr>
                        <tr><td>MySQL wire</td><td data-label="Client">mysql</td><td data-label="Declare">--mysql-port</td><td data-label="Status"><span class="status-text"><span class="live-dot"></span>Live</span></td></tr>
                        <tr><td>Redis</td><td data-label="Client">redis-cli</td><td data-label="Declare">--redis-port</td><td data-label="Status"><span class="status-text"><span class="live-dot"></span>Live</span></td></tr>
                        <tr><td>MongoDB</td><td data-label="Client">mongosh</td><td data-label="Declare">--mongo-port</td><td data-label="Status"><span class="status-text"><span class="probe-dot"></span>Probe</span></td></tr>
                        <tr><td>YY wire</td><td data-label="Client">@yydb/yydb-client</td><td data-label="Declare">--wire-port · TCP+WS</td><td data-label="Status"><span class="status-text"><span class="live-dot"></span>Live</span></td></tr>
                    </tbody>
                </table>
            </div>
        </section>
        <section class="ops-section">
            <div class="landing-wrap ops-section__grid">
                <div class="ops-section__lead">
                    <p class="overline">02 — Control plane</p>
                    <h2>{{ homeFeatureTitleLabel }}</h2>
                    <p class="section-description">{{ homeFeatureLedeLabel }}</p>
                    <p class="command-chain" data-reveal="true" aria-label="Node lifecycle"><span>init</span><i>→</i><span>start</span><i>→</i><span>status</span><i>→</i><span>stop</span></p>
                    <div class="schema-panel" data-reveal="true">
                        <div class="schema-panel__bar"><span>Schema · VOS</span><span>Catalog</span></div>
                        <pre>table Setting {<br>@@id: uuid,<br>key: utf8,<br>value: utf8,<br>}</pre>
                        <div class="schema-panel__foot"><span>yyds catalog --catalog-path … --schema-file …</span></div>
                    </div>
                </div>
                <div class="capability-list">
                    <article data-reveal="true"><span class="feature-symbol" aria-hidden="true">01 / Define</span><h3>{{ homeFeatureSchemaTitleLabel }}</h3><p>{{ homeFeatureSchemaBodyLabel }}</p><a href="/d/" :aria-label="homeFeatureSchemaTitleLabel">↗</a></article>
                    <article data-reveal="true"><span class="feature-symbol" aria-hidden="true">02 / Operate</span><h3>{{ homeFeatureDurabilityTitleLabel }}</h3><p>{{ homeFeatureDurabilityBodyLabel }}</p><a href="/d/" :aria-label="homeFeatureDurabilityTitleLabel">↗</a></article>
                    <article data-reveal="true"><span class="feature-symbol" aria-hidden="true">03 / Connect</span><h3>{{ homeFeatureHostTitleLabel }}</h3><p>{{ homeFeatureHostBodyLabel }}</p><a href="/d/" :aria-label="homeFeatureHostTitleLabel">↗</a></article>
                </div>
            </div>
        </section>
        <section class="closing-section">
            <div class="landing-wrap" data-reveal="true">
                <p class="overline">03 — Start building</p>
                <h2>{{ homeClosingTitleLabel }}</h2>
                <div class="closing-section__bottom"><p>{{ homeClosingBodyLabel }}</p><a class="action action--primary" href="/install">{{ homeClosingActionLabel }}<span aria-hidden="true">→</span></a></div>
                <div class="service-signature" aria-hidden="true"><span>YYDS</span><span>By YY / Open source</span></div>
            </div>
        </section>
    </main>
    <SiteFooter />
</template>

<script client>
import { homeEyebrow, homeHeroLine1, homeHeroLine2, homeLede, homeActionInstall, homeActionDocs, homeInstallHint, homePrinciple1Title, homePrinciple1Body, homePrinciple2Title, homePrinciple2Body, homePrinciple3Title, homePrinciple3Body, homeFeatureTitle, homeFeatureLede, homeFeatureSchemaTitle, homeFeatureSchemaBody, homeFeatureDurabilityTitle, homeFeatureDurabilityBody, homeFeatureHostTitle, homeFeatureHostBody, homeArchitectureTitle, homeArchitectureBody, homeArchitectureLink, homeClosingTitle, homeClosingBody, homeClosingAction, homeTopologyCaption, homeEdition, titleHome } from "#locales/common";
import { readLocaleId, withLocaleHint, watchDocumentLocale } from "../lib/locale-copy.ts";

export default class Home {
    homeEyebrowLabel = "";
    homeHeroLine1Label = "";
    homeHeroLine2Label = "";
    homeLedeLabel = "";
    homeActionInstallLabel = "";
    homeActionDocsLabel = "";
    homeInstallHintLabel = "";
    homePrinciple1TitleLabel = "";
    homePrinciple1BodyLabel = "";
    homePrinciple2TitleLabel = "";
    homePrinciple2BodyLabel = "";
    homePrinciple3TitleLabel = "";
    homePrinciple3BodyLabel = "";
    homeFeatureTitleLabel = "";
    homeFeatureLedeLabel = "";
    homeFeatureSchemaTitleLabel = "";
    homeFeatureSchemaBodyLabel = "";
    homeFeatureDurabilityTitleLabel = "";
    homeFeatureDurabilityBodyLabel = "";
    homeFeatureHostTitleLabel = "";
    homeFeatureHostBodyLabel = "";
    homeArchitectureTitleLabel = "";
    homeArchitectureBodyLabel = "";
    homeArchitectureLinkLabel = "";
    homeClosingTitleLabel = "";
    homeClosingBodyLabel = "";
    homeClosingActionLabel = "";
    homeTopologyCaptionLabel = "";
    homeEditionLabel = "";
    installChipText = "npm install @yydb/yyds";
    installChipAria = "Copy install command";
    _installChipTimer = null;
    _revealObserver = null;
    _unwatchLocale = null;
    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
        this.setupReveal();
    }
    onDestroy() {
        if (typeof this._unwatchLocale === "function") this._unwatchLocale();
        this._unwatchLocale = null;
        if (this._revealObserver) this._revealObserver.disconnect();
        this._revealObserver = null;
        if (this._installChipTimer) clearTimeout(this._installChipTimer);
        this._installChipTimer = null;
    }
    async copyInstall() {
        const command = "npm install @yydb/yyds";
        let copied = false;
        try {
            if (typeof navigator !== "undefined" && navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(command);
                copied = true;
            }
        } catch {
            copied = false;
        }
        if (!copied && typeof document !== "undefined") {
            try {
                const helper = document.createElement("textarea");
                helper.value = command;
                helper.setAttribute("readonly", "");
                helper.style.position = "absolute";
                helper.style.left = "-9999px";
                document.body.appendChild(helper);
                helper.select();
                copied = document.execCommand("copy");
                document.body.removeChild(helper);
            } catch {
                copied = false;
            }
        }
        if (copied) {
            this.installChipText = "COPIED · npm install @yydb/yyds";
        } else if (typeof window !== "undefined" && typeof window.getSelection === "function") {
            const target = document.querySelector(".install-chip__text");
            const selection = window.getSelection();
            if (target && selection) {
                const range = document.createRange();
                range.selectNodeContents(target);
                selection.removeAllRanges();
                selection.addRange(range);
            }
            this.installChipText = "PRESS Ctrl+C · npm install @yydb/yyds";
        }
        if (this._installChipTimer) clearTimeout(this._installChipTimer);
        this._installChipTimer = setTimeout(() => {
            this.installChipText = command;
            this._installChipTimer = null;
        }, 1600);
    }
    setupReveal() {
        if (typeof document === "undefined" || typeof IntersectionObserver === "undefined") return;
        const items = Array.from(document.querySelectorAll("[data-reveal]"));
        if (items.length === 0) return;
        const reduce = typeof matchMedia === "function" && matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduce) {
            items.forEach((el) => el.classList.add("is-revealed"));
            return;
        }
        const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("is-revealed");
                    io.unobserve(entry.target);
                }
            });
        }, { threshold: 0.15, rootMargin: "0px 0px 12% 0px" });
        items.forEach((el) => io.observe(el));
        this._revealObserver = io;
    }
    applyLocaleCopy(preferred) {
        withLocaleHint(readLocaleId(preferred), () => this.refreshCopy());
    }
    refreshCopy() {
        this.homeEyebrowLabel = homeEyebrow();
        this.homeHeroLine1Label = homeHeroLine1();
        this.homeHeroLine2Label = homeHeroLine2();
        this.homeLedeLabel = homeLede();
        this.homeActionInstallLabel = homeActionInstall();
        this.homeActionDocsLabel = homeActionDocs();
        this.homeInstallHintLabel = homeInstallHint();
        this.homePrinciple1TitleLabel = homePrinciple1Title();
        this.homePrinciple1BodyLabel = homePrinciple1Body();
        this.homePrinciple2TitleLabel = homePrinciple2Title();
        this.homePrinciple2BodyLabel = homePrinciple2Body();
        this.homePrinciple3TitleLabel = homePrinciple3Title();
        this.homePrinciple3BodyLabel = homePrinciple3Body();
        this.homeFeatureTitleLabel = homeFeatureTitle();
        this.homeFeatureLedeLabel = homeFeatureLede();
        this.homeFeatureSchemaTitleLabel = homeFeatureSchemaTitle();
        this.homeFeatureSchemaBodyLabel = homeFeatureSchemaBody();
        this.homeFeatureDurabilityTitleLabel = homeFeatureDurabilityTitle();
        this.homeFeatureDurabilityBodyLabel = homeFeatureDurabilityBody();
        this.homeFeatureHostTitleLabel = homeFeatureHostTitle();
        this.homeFeatureHostBodyLabel = homeFeatureHostBody();
        this.homeArchitectureTitleLabel = homeArchitectureTitle();
        this.homeArchitectureBodyLabel = homeArchitectureBody();
        this.homeArchitectureLinkLabel = homeArchitectureLink();
        this.homeClosingTitleLabel = homeClosingTitle();
        this.homeClosingBodyLabel = homeClosingBody();
        this.homeClosingActionLabel = homeClosingAction();
        this.homeTopologyCaptionLabel = homeTopologyCaption();
        this.homeEditionLabel = homeEdition();
        if (typeof document !== "undefined") document.title = titleHome();
    }
}
</script>
