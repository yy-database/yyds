                    <div class="landing-actions">
                        <a class="action action--primary" href="/install">{{ homeActionInstallLabel }}<span aria-hidden="true">→</span></a>
                        <a class="action action--text" href="/d/">{{ homeActionDocsLabel }}</a>
                    </div>
                </div>
                <figure class="landing-hero__mesh">
                    <svg class="mesh-svg" viewBox="0 0 690 470" role="img" aria-label="YYDS cluster topology: clients on the left reach the gateway through five declared ports, the gateway connects to the running leader node, the control plane sits above the leader, and replica nodes remain on the roadmap">
<text class="at-meta" x="0" y="16">Cluster region · c1</text>
<g><rect class="at-solid-blue" x="470" y="0" width="220" height="76"/>
<text class="at-control-title" x="486" y="26">Control plane</text>
<text class="at-control-meta" x="486" y="46">init · start · status</text>
<text class="at-control-meta" x="486" y="62">stop · catalog · webui</text></g>
<path class="at-link" d="M580 76V230"/>
