<template>
    <SiteHeader />
    <main class="main">
        <div class="home">
            <section class="home__hero">
                <div>
                    <p class="home__eyebrow">{{ homeEyebrowLabel }}</p>
                    <h1 class="home__brand">{{ brandShortLabel }}</h1>
                    <p>{{ brandFullLabel }}</p>
                    <p class="home__lede">{{ homeLedeLabel }}</p>
                    <div class="home__actions">
                        <Button type="button" @click="goInstall">{{ homeActionInstallLabel }}</Button>
                        <Button type="button" variant="secondary" @click="goDocs">{{ homeActionDocsLabel }}</Button>
                    </div>
                </div>
                <div class="home__card">
                    <code>@yydb/yyds</code>
                    <p>{{ homeTaglineLabel }}</p>
                    <Button type="button" variant="secondary" @click="goWire">{{ homeWireLinkLabel }}</Button>
                </div>
            </section>

            <section class="home__section">
                <div class="home__section-head">
                    <h2>{{ homeFeatureTitleLabel }}</h2>
                    <p>{{ homeFeatureLedeLabel }}</p>
                </div>
                <div class="home__feature-grid">
                    <article>
                        <h3>{{ homeFeatureSchemaTitleLabel }}</h3>
                        <p>{{ homeFeatureSchemaBodyLabel }}</p>
                    </article>
                    <article>
                        <h3>{{ homeFeatureDurabilityTitleLabel }}</h3>
                        <p>{{ homeFeatureDurabilityBodyLabel }}</p>
                    </article>
                    <article>
                        <h3>{{ homeFeatureHostTitleLabel }}</h3>
                        <p>{{ homeFeatureHostBodyLabel }}</p>
                    </article>
                    <article>
                        <h3>{{ homeFeatureWireTitleLabel }}</h3>
                        <p>{{ homeFeatureWireBodyLabel }}</p>
                    </article>
                </div>
            </section>

            <section class="home__section">
                <div class="home__section-head">
                    <h2>{{ homePackagesTitleLabel }}</h2>
                    <p>{{ homePackagesLedeLabel }}</p>
                </div>
                <div class="home__pkg-grid">
                    <article>
                        <code>@yydb/yyds</code>
                        <p>{{ homePkgYydbLabel }}</p>
                    </article>
                    <article>
                        <code>@yydb/yydb-client</code>
                        <p>{{ homePkgClientLabel }}</p>
                    </article>
                    <article>
                        <code>@yydb/yyds-webui</code>
                        <p>{{ homePkgWebuiLabel }}</p>
                    </article>
                    <article>
                        <code>@yydb/yyds-skills</code>
                        <p>{{ homePkgSkillsLabel }}</p>
                    </article>
                </div>
            </section>
        </div>
    </main>
    <SiteFooter />
</template>

<script client>
import {
    brandShort,
    brandFull,
    homeEyebrow,
    homeLede,
    homeTagline,
    homeActionInstall,
    homeActionDocs,
    homeFeatureTitle,
    homeFeatureLede,
    homeFeatureSchemaTitle,
    homeFeatureSchemaBody,
    homeFeatureDurabilityTitle,
    homeFeatureDurabilityBody,
    homeFeatureHostTitle,
    homeFeatureHostBody,
    homeFeatureWireTitle,
    homeFeatureWireBody,
    homePackagesTitle,
    homePackagesLede,
    homePkgYydb,
    homePkgClient,
    homePkgWebui,
    homePkgSkills,
    homeWireLink,
} from "#locales/common";
import { readLocaleId, withLocaleHint, watchDocumentLocale } from "../lib/locale-copy.ts";

export default class IndexPage {
    brandShortLabel = "";
    brandFullLabel = "";
    homeEyebrowLabel = "";
    homeLedeLabel = "";
    homeTaglineLabel = "";
    homeActionInstallLabel = "";
    homeActionDocsLabel = "";
    homeFeatureTitleLabel = "";
    homeFeatureLedeLabel = "";
    homeFeatureSchemaTitleLabel = "";
    homeFeatureSchemaBodyLabel = "";
    homeFeatureDurabilityTitleLabel = "";
    homeFeatureDurabilityBodyLabel = "";
    homeFeatureHostTitleLabel = "";
    homeFeatureHostBodyLabel = "";
    homeFeatureWireTitleLabel = "";
    homeFeatureWireBodyLabel = "";
    homePackagesTitleLabel = "";
    homePackagesLedeLabel = "";
    homePkgYydbLabel = "";
    homePkgClientLabel = "";
    homePkgWebuiLabel = "";
    homePkgSkillsLabel = "";
    homeWireLinkLabel = "";
    _unwatchLocale = null;

    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
    }

    onDestroy() {
        if (typeof this._unwatchLocale === "function") {
            this._unwatchLocale();
        }
        this._unwatchLocale = null;
    }

    refreshCopy() {
        this.brandShortLabel = brandShort();
        this.brandFullLabel = brandFull();
        this.homeEyebrowLabel = homeEyebrow();
        this.homeLedeLabel = homeLede();
        this.homeTaglineLabel = homeTagline();
        this.homeActionInstallLabel = homeActionInstall();
        this.homeActionDocsLabel = homeActionDocs();
        this.homeFeatureTitleLabel = homeFeatureTitle();
        this.homeFeatureLedeLabel = homeFeatureLede();
        this.homeFeatureSchemaTitleLabel = homeFeatureSchemaTitle();
        this.homeFeatureSchemaBodyLabel = homeFeatureSchemaBody();
        this.homeFeatureDurabilityTitleLabel = homeFeatureDurabilityTitle();
        this.homeFeatureDurabilityBodyLabel = homeFeatureDurabilityBody();
        this.homeFeatureHostTitleLabel = homeFeatureHostTitle();
        this.homeFeatureHostBodyLabel = homeFeatureHostBody();
        this.homeFeatureWireTitleLabel = homeFeatureWireTitle();
        this.homeFeatureWireBodyLabel = homeFeatureWireBody();
        this.homePackagesTitleLabel = homePackagesTitle();
        this.homePackagesLedeLabel = homePackagesLede();
        this.homePkgYydbLabel = homePkgYydb();
        this.homePkgClientLabel = homePkgClient();
        this.homePkgWebuiLabel = homePkgWebui();
        this.homePkgSkillsLabel = homePkgSkills();
        this.homeWireLinkLabel = homeWireLink();
    }

    applyLocaleCopy(preferred) {
        withLocaleHint(readLocaleId(preferred), () => this.refreshCopy());
    }

    goInstall() {
        if (typeof window !== "undefined") {
            window.location.href = "/install";
        }
    }

    goDocs() {
        if (typeof window !== "undefined") {
            window.location.href = "/d/";
        }
    }

    goWire() {
        if (typeof window !== "undefined") {
            window.location.href = "/wire";
        }
    }
}
</script>
