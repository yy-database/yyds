<g><text class="at-client" x="0" y="130">psql</text><text class="at-sub" x="0" y="150">PostgreSQL · 5432</text><path class="at-link" d="M232 125H268"/></g>
<g><text class="at-client" x="0" y="182">mysql</text><text class="at-sub" x="0" y="202">MySQL · 3306</text><path class="at-link" d="M232 177H268"/></g>
<g><text class="at-client" x="0" y="234">redis-cli</text><text class="at-sub" x="0" y="254">Redis · 6379</text><path class="at-link" d="M232 229H268"/></g>
