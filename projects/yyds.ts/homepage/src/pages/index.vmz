            <div class="landing-wrap ops-section__grid">
                <div class="ops-section__lead">
                    <p class="overline">02 — CONTROL PLANE</p>
                    <h2>{{ homeFeatureTitleLabel }}</h2>
                    <p class="section-description">{{ homeFeatureLedeLabel }}</p>
                    <p class="command-chain" data-reveal="true" aria-label="Node lifecycle"><span>init</span><i>→</i><span>start</span><i>→</i><span>status</span><i>→</i><span>stop</span></p>
                    <div class="schema-panel" data-reveal="true">
                        <div class="schema-panel__bar"><span>SCHEMA · VOS</span><span>CATALOG</span></div>
