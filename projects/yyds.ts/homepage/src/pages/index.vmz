<text class="at-replica-title" x="486" y="384">Replicas · N2, N3</text><text class="at-sub" x="486" y="404">Roadmap · not scheduled</text></g>
<text class="at-meta" x="0" y="446">Every connection has a declared path</text>
<path class="at-rule" d="M0 466H690"/>
</svg>
                    <svg class="mesh-svg-mobile" viewBox="0 0 360 570" role="img" aria-label="YYDS cluster topology: control plane above the leader node, replica nodes on the roadmap, a declared gateway in the middle, and clients below">
<text class="at-meta" x="0" y="18">Cluster region · c1</text>
<g><rect class="at-solid-blue" x="0" y="36" width="360" height="64"/>
<text class="at-control-title" x="16" y="60">Control plane</text>
<text class="at-control-meta" x="16" y="82">init · start · status · stop · catalog</text></g>
