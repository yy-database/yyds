{
    "name": "@yyds/yyds-unknown-wasm32",
    "version": "0.1.0",
    "description": "Browser WebAssembly binary for @yyds/yyds",
    "license": "MPL-2.0",
    "private": true,
    "type": "module",
    "sideEffects": ["./lib/yyds_wasm.js"],
